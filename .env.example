# Copy this file to .env in the same folder. Docker Compose reads .env.
# Do not commit the filled-in .env.
#
# MongoDB Atlas. The Compose file does not start a database.
# The path must include the database name. Images and audio are stored in this database.
# Video stays in the uploads folder.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/surshongi?retryWrites=true&w=majority

# Published API image. docker compose up pulls this from Docker Hub.
DOCKER_IMAGE=2011331031/surshongi-api:latest
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3010
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
UPLOAD_DIR=/app/uploads
